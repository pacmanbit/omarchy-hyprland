#!/usr/bin/env python3
"""
Islamic Prayer Times for Omarchy / Hyprland Bar
Configurable via ~/.config/omarchy/prayer-times.json or env vars:
  PRAYER_CITY, PRAYER_COUNTRY, PRAYER_METHOD
Defaults to Al-Karak, Jordan (Ministry of Awqaf & Islamic Affairs).

3-State Color System:
  - NOW:   Prayer time active (first 20 mins) -> Vibrant Green (#50FA7B)
  - CLOSE: Upcoming within 30 mins -> Warm Amber (#FAB387)
  - FAR:   More than 30 mins away -> Default Theme Foreground
"""

import os
import sys
import json
import urllib.request
import urllib.parse
import subprocess
from datetime import datetime, timedelta

CONFIG_FILE = os.path.expanduser("~/.config/omarchy/prayer-times.json")

def load_config():
    cfg = {"city": "Al-Karak", "country": "Jordan", "method": "JORDAN"}
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                user_cfg = json.load(f)
                for k in ("city", "country", "method"):
                    if user_cfg.get(k):
                        cfg[k] = str(user_cfg[k])
        except Exception:
            pass
    cfg["city"] = os.environ.get("PRAYER_CITY", cfg["city"])
    cfg["country"] = os.environ.get("PRAYER_COUNTRY", cfg["country"])
    cfg["method"] = os.environ.get("PRAYER_METHOD", cfg["method"])
    return cfg

CFG = load_config()
CITY = CFG["city"]
COUNTRY = CFG["country"]
METHOD = CFG["method"]

COLOR_NOW = "#50FA7B"
COLOR_CLOSE = "#FAB387"
COLOR_FAR = ""

CLOSE_THRESHOLD_MINUTES = 30
NOW_WINDOW_MINUTES = 20

CACHE_DIR = os.path.expanduser("~/.cache/omarchy")
CACHE_FILE = os.path.join(CACHE_DIR, "prayer_times_cache.json")
NOTIF_STATE_FILE = os.path.join(CACHE_DIR, "prayer_notif_sent.json")

PRAYERS = [
    ("Fajr", "الفجر", "06:01", True),
    ("Sunrise", "الشروق", "07:11", False),
    ("Dhuhr", "الظهر", "12:24", True),
    ("Asr", "العصر", "15:17", True),
    ("Maghrib", "المغرب", "17:36", True),
    ("Isha", "العشاء", "18:46", True),
]

def fetch_timings(force=False):
    os.makedirs(CACHE_DIR, exist_ok=True)
    today_str = datetime.now().strftime("%Y-%m-%d")

    if not force and os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r") as f:
                data = json.load(f)
                if (
                    data.get("date") == today_str
                    and data.get("city") == CITY
                    and data.get("country") == COUNTRY
                    and data.get("method") == METHOD
                    and "timings" in data
                ):
                    return data["timings"]
        except Exception:
            pass

    try:
        query = urllib.parse.urlencode({"city": CITY, "country": COUNTRY, "method": METHOD})
        url = f"https://api.aladhan.com/v1/timingsByCity?{query}"
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (compatible; Omarchy/1.0)"})
        with urllib.request.urlopen(req, timeout=6) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            timings = res.get("data", {}).get("timings", {})
            if timings:
                cache_payload = {
                    "date": today_str,
                    "city": CITY,
                    "country": COUNTRY,
                    "method": METHOD,
                    "timings": timings,
                    "fetched_at": datetime.now().isoformat(),
                }
                with open(CACHE_FILE, "w") as f:
                    json.dump(cache_payload, f, indent=2)
                return timings
    except Exception:
        if os.path.exists(CACHE_FILE):
            try:
                with open(CACHE_FILE, "r") as f:
                    data = json.load(f)
                    if "timings" in data:
                        return data["timings"]
            except Exception:
                pass

    return {en: fb for en, _, fb, _ in PRAYERS}

def get_prayer_status(timings):
    now = datetime.now()
    today = now.date()

    parsed = []
    for en, ar, fallback, is_salah in PRAYERS:
        raw_val = timings.get(en, fallback).split(" ")[0]
        try:
            h, m = map(int, raw_val.split(":")[:2])
            dt = datetime(today.year, today.month, today.day, h, m)
        except Exception:
            h, m = 12, 0
            dt = datetime(today.year, today.month, today.day, h, m)
        parsed.append((en, ar, dt, f"{h:02d}:{m:02d}", is_salah))

    now_prayer = None
    for en, ar, dt, fmt, is_salah in parsed:
        if is_salah:
            diff_secs = (now - dt).total_seconds()
            if 0 <= diff_secs <= NOW_WINDOW_MINUTES * 60:
                mins_in = int(diff_secs // 60)
                now_prayer = (en, ar, fmt, mins_in)
                break

    next_event = None
    rem = None
    for en, ar, dt, fmt, is_salah in parsed:
        if dt > now:
            next_event = (en, ar, fmt, is_salah)
            rem = dt - now
            break

    if not next_event:
        en0, ar0, dt0, fmt0, is_salah0 = parsed[0]
        dt_tomorrow = dt0 + timedelta(days=1)
        next_event = (en0, ar0, fmt0, is_salah0)
        rem = dt_tomorrow - now

    next_en, next_ar, next_fmt, _ = next_event
    total_secs = max(0, int(rem.total_seconds()))
    hours = total_secs // 3600
    mins = (total_secs % 3600) // 60
    rem_str = f"{hours}h {mins}m" if hours > 0 else f"{mins}m"

    if now_prayer:
        state = "now"
        en, ar, fmt, mins_in = now_prayer
        time_tag = f" (+{mins_in}m)" if mins_in > 0 else ""
        bar_text = f"󱡖 {en} NOW{time_tag}"
        color = COLOR_NOW
    elif total_secs <= CLOSE_THRESHOLD_MINUTES * 60:
        state = "close"
        bar_text = f"󱡖 {next_en} {next_fmt} ({rem_str})"
        color = COLOR_CLOSE
    else:
        state = "far"
        bar_text = f"󱡖 {next_en} {next_fmt}"
        color = COLOR_FAR

    return parsed, now_prayer, next_event, rem_str, state, bar_text, color

def check_auto_notification(state, now_prayer):
    if state != "now" or not now_prayer:
        return
    en, ar, fmt, _ = now_prayer
    today_str = datetime.now().strftime("%Y-%m-%d")
    key = f"{today_str}_{en}"

    sent_keys = []
    if os.path.exists(NOTIF_STATE_FILE):
        try:
            with open(NOTIF_STATE_FILE, "r") as f:
                sent_keys = json.load(f)
        except Exception:
            sent_keys = []

    if key not in sent_keys:
        try:
            subprocess.run([
                "notify-send",
                "-a", "Prayer Times",
                f"🕌 It is now time for {en} ({ar})",
                f"{CITY}, {COUNTRY} — {fmt}"
            ], check=False)
        except FileNotFoundError:
            pass
        sent_keys.append(key)
        sent_keys = sent_keys[-20:]
        try:
            with open(NOTIF_STATE_FILE, "w") as f:
                json.dump(sent_keys, f)
        except Exception:
            pass

def main():
    force_refresh = "--refresh" in sys.argv
    show_notification = "--notify" in sys.argv

    timings = fetch_timings(force=force_refresh)
    parsed, now_prayer, next_event, rem_str, state, bar_text, color = get_prayer_status(timings)
    next_en, next_ar, next_fmt, _ = next_event

    tooltip_lines = [
        f"🕌 Islamic Prayer Times — {CITY}, {COUNTRY}",
        f"Method: {METHOD}",
        "─────────────────────────"
    ]
    for en, ar, dt, fmt, _ in parsed:
        if now_prayer and now_prayer[0] == en:
            marker = "🟢 NOW ▶"
        elif not now_prayer and next_en == en:
            marker = "🟡 NEXT ▶"
        else:
            marker = "       "
        tooltip_lines.append(f"{marker} {en:<8} ({ar}): {fmt}")

    tooltip_lines.append("─────────────────────────")
    if state == "now":
        en, ar, fmt, mins_in = now_prayer
        tooltip_lines.append(f"🟢 Active: {en} ({ar}) prayer is NOW (+{mins_in}m elapsed)")
    elif state == "close":
        tooltip_lines.append(f"🟡 Upcoming: {next_en} ({next_ar}) in {rem_str} (Approaching)")
    else:
        tooltip_lines.append(f"⚪ Next: {next_en} ({next_ar}) in {rem_str}")

    tooltip_lines.append("(Click for notification • Right-click to refresh)")
    tooltip_text = "\n".join(tooltip_lines)

    if show_notification:
        notif_body = "\n".join([f"{en} ({ar}): {fmt}" for en, ar, dt, fmt, _ in parsed])
        if state == "now":
            notif_body += f"\n\n🟢 PRAYER TIME NOW: {now_prayer[0]} ({now_prayer[1]})"
        else:
            notif_body += f"\n\n▶ Next: {next_en} at {next_fmt} (in {rem_str})"
        try:
            subprocess.run([
                "notify-send",
                "-a", "Prayer Times",
                f"Prayer Times — {CITY}, {COUNTRY}",
                notif_body
            ], check=False)
        except FileNotFoundError:
            pass
        return

    check_auto_notification(state, now_prayer)

    output = {
        "text": bar_text,
        "tooltip": tooltip_text,
        "class": state,
        "color": color
    }
    print(json.dumps(output))

if __name__ == "__main__":
    main()
